  <!-- Asset とシェーダーのソースを出力フォルダへコピーする（xcopy は日本語パスで失敗するため MSBuild の Copy を使う） -->
  <Target Name="CopyGameFiles" AfterTargets="Build">
    <ItemGroup>
      <GameAssetFiles Include="$(ProjectDir)Asset\**\*" />
      <ShaderSourceFiles Include="$(ProjectDir)*.hlsl" />
    </ItemGroup>
    <Message Importance="high" Text="Copy Asset and shader sources to the output folder" />
    <Copy SourceFiles="@(GameAssetFiles)" DestinationFiles="@(GameAssetFiles->'$(OutDir)Asset\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ShaderSourceFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
